# Скопируйте в .env и вставьте токен из Discord Developer Portal.
DISCORD_TOKEN=replace_with_your_secret_token
DISCORD_GUILD_ID=1439347293076586638
DATABASE_URL=sqlite+aiosqlite:////app/data/newsqad.db
DATA_DIR=/app/data
TIMEZONE=Europe/Tallinn
LOG_LEVEL=INFO
# Дополнительные владельцы бота (через запятую), необязательно.
BOT_OWNER_IDS=

# Для начисления XP за текстовые сообщения; включите Message Content Intent в Discord Developer Portal.
ENABLE_MESSAGE_CONTENT_INTENT=false

# Базовый образ Docker. По умолчанию официальное зеркало Python на AWS ECR.
# Если ECR недоступен, переключите на Docker Hub после docker login:
# PYTHON_BASE_IMAGE=python:3.12-slim-bookworm
PYTHON_BASE_IMAGE=public.ecr.aws/docker/library/python:3.12-slim-bookworm

# Локальная web-панель: генерируйте хэш, не пишите сюда пароль!
# python -m app.web.auth hash
# После заполнения откройте http://127.0.0.1:8787
WEB_ADMIN_PASSWORD_HASH=
WEB_ADMIN_PORT=8787
# Адрес слушателя выставляется compose.yaml для контейнера.


# --- Web Portal 2.0: Discord OAuth (staff from any browser) ---
# Set ALL three values together. Password login is disabled in OAuth mode.
WEB_DISCORD_CLIENT_ID=
WEB_DISCORD_CLIENT_SECRET=
# HTTPS URL of Tailscale Funnel without trailing slash or /auth/callback.
# Example: https://my-pc.my-tailnet.ts.net
WEB_PUBLIC_URL=
# To show presence, enable PRESENCE INTENT in Discord Developer Portal too.
ENABLE_PRESENCE_INTENT=false
# For ticket chat text, enable privileged Message Content Intent in Discord Portal.
# ENABLE_MESSAGE_CONTENT_INTENT=true
